{
  "name": "turbogrid-driver",
  "version": "1.0.1-beta.3",
  "description": "Turbo Grid Driver Panel",
  "main": "src/main.js",
  "author": "AleEjx",
  "scripts": {
    "start": "electron .",
    "rebuild-native": "electron-builder install-app-deps",
    "build": "npm run rebuild-native && electron-builder --win --publish never",
    "dist": "npm run rebuild-native && electron-builder --win --publish always"
  },
  "build": {
    "appId": "com.turbogrid.driver",
    "productName": "TurboGrid Driver",
    "publish": {
      "provider": "github",
      "owner": "AleEjx",
      "repo": "turbogrid-app"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "asarUnpack": [
      "node_modules/uiohook-napi/**/*"
    ]
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.1.7",
    "uiohook-napi": "^1.5.5"
  }
}
